# Read by compose (interpolation) and passed to the container: placeholders below.
APP_HOST=app.example.com
AUTH_ISSUER=https://auth.example.com
GATEWAY_URL=https://llm.example.com
AUTH_CLIENT_ID=test-app-python
# Secrets: never commit the filled file.
AUTH_CLIENT_SECRET=
# 32+ random characters, e.g. `openssl rand -base64 48`
COOKIE_SECRET=
